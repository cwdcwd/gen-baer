# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Upstash Redis Configuration
# Create a Redis database at: https://console.upstash.com/
# Copy the REST API URL and token from your database details
KV_REST_API_URL=https://your-redis-url.upstash.io
KV_REST_API_TOKEN=your-upstash-redis-token

# Authentication Secrets
# Generate secure random strings for these (e.g., using `openssl rand -hex 32`)
# CRON_SECRET is used by Vercel Cron to authenticate scheduled theme generation
CRON_SECRET=your-secure-random-string-for-cron
# ADMIN_SECRET is used to manually trigger theme generation via API
ADMIN_SECRET=your-secure-random-string-for-admin
# CACHE_CLEAR_SECRET is used to authenticate cache clearing via API
CACHE_CLEAR_SECRET=your-secure-random-string-for-cache

# Vercel Edge Config (Optional)
# Used to dynamically configure theme rotation without redeployment
# Get this from: https://vercel.com/docs/storage/edge-config
# EDGE_CONFIG=https://edge-config.vercel.com/xxxxx?token=xxxxx

# Vercel Blob Storage (Optional - for AI background images)
# Used to store AI-generated background images
# Create a Blob store at: https://vercel.com/dashboard/stores?type=blob
# If not configured, themes will use SVG pattern fallbacks instead
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx

# Hardcover API Token (Optional)
# Hardcover's GraphQL API is public and doesn't require authentication
# Only needed if you have a private reading list or need higher rate limits
# HARDCOVER_API_TOKEN=your-hardcover-api-token
